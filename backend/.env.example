NEXORA_APP_NAME="Nexora API"
NEXORA_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Replace these example credentials; the database must already exist.
DATABASE_URL="postgresql+psycopg://nexora:change_me@localhost:5432/nexora"

# False only for local HTTP development; keep true for HTTPS production.
NEXORA_COOKIE_SECURE=true
